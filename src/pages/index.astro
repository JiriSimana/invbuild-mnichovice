---
import Layout      from '../layouts/Layout.astro';
import Header      from '../components/Header.astro';
import Hero        from '../components/Hero.astro';
import Section     from '../components/Section.astro';
import SectionNav  from '../components/SectionNav.astro';
import Gallery     from '../components/Gallery.astro';
import StorySplit  from '../components/StorySplit.astro';
import Lokalita    from '../components/Lokalita.astro';
import Services    from '../components/Services.astro';
import Kontakt     from '../components/Kontakt.astro';
import Footer      from '../components/Footer.astro';
import Reveal      from '../components/Reveal.astro';

// ----- HERO -----
const stats = [
  { label: 'Rozloha pozemku', value: '480 m²' },
  { label: 'Užitná plocha',    value: '159 m²' },
  { label: 'Dispozice',         value: '5+1'    },
  { label: 'Cena',              value: '31 900 000 Kč' },
];

const heroImages = [
  { src: '/img/mnichovice-01.webp', alt: 'Rodinný dům Mnichovice — pohled z ulice' },
  { src: '/img/mnichovice-05.webp', alt: 'Rodinný dům Mnichovice — boční pohled' },
  { src: '/img/mnichovice-07.webp', alt: 'Rodinný dům Mnichovice — exteriér s terasou' },
];

const galleryImages = Array.from({ length: 16 }, (_, i) => {
  const n = String(i + 1).padStart(2, '0');
  return { src: `/img/mnichovice-${n}.webp`, alt: `Vizualizace ${i + 1} — Rodinný dům Mnichovice` };
});

const locGroups = [
  {
    id: '1np',
    title: '1. NP',
    content: `<p><strong>Celková užitná plocha podlaží: 77,3 m²</strong></p>
      <ul>
        <li><strong>Ložnice</strong> o rozloze 16,37 m² je vybavena laminátovou podlahou, stěny jsou pokryty omítkou.</li>
        <li><strong>Koupelna a WC</strong> zabírají 4,03 m² a jsou vybaveny keramickou dlažbou a obkladem.</li>
        <li><strong>Technická místnost</strong> má 1,36 m² s keramickou podlahou a obkladem.</li>
        <li><strong>Vstupní hala</strong> s rozlohou 11,05 m² vyniká keramickou dlažbou a omítkou na stěnách.</li>
        <li><strong>Obývací pokoj</strong> je na 18,27 m² s laminátovou podlahou a kombinací obkladu a omítky.</li>
        <li><strong>Kuchyňská část</strong> pokrývá 13,43 m² s keramickou podlahou a stěnami s omítkou a obkladem.</li>
        <li><strong>Jídelna</strong> má 12,67 m², keramickou podlahu a stěny s omítkou a obkladem.</li>
      </ul>`,
  },
  {
    id: '2np',
    title: '2. NP',
    content: `<p><strong>Celková užitná plocha podlaží: 81,8 m²</strong></p>
      <ul>
        <li><strong>První ložnice</strong> má 18,89 m² s laminátovou podlahou a stěnami s omítkou a obkladem.</li>
        <li><strong>Druhá ložnice</strong> je větší s 23,00 m², také s laminátovou podlahou a stěnami s omítkou a obkladem.</li>
        <li><strong>Koupelna a WC</strong> zabírají 3,43 m² a mají keramickou podlahu a obklad.</li>
        <li><strong>Chodba</strong> má 13,49 m² s laminátovou podlahou a omítkou na stěnách.</li>
        <li><strong>Terasa</strong> je prostorná s 16,55 m² a keramickou podlahou.</li>
      </ul>`,
  },
  {
    id: 'tech',
    title: 'Technické vybavení',
    content: `<p>V rámci objektu dojde k instalaci rozvodů vody, kanalizace, elektřiny a vytápění
      s tepelným čerpadlem vzduch/voda. Objekt bude rovněž chráněn proti blesku.</p>
      <ul>
        <li><strong>Splašková odpadní voda</strong> potečou přes PVC kanalizační přípojku do hlavního kanalizačního řadu.</li>
        <li><strong>Zásobování vodou</strong> zajistí upravená vodovodní přípojka, zatímco dešťová voda bude odvedena do retenční nádrže na pozemku.</li>
        <li><strong>Elektrická energie</strong> bude přivedena připojením objektu na síť nízkého napětí (NN).</li>
        <li><strong>Dispozice 5+1</strong>, 2 koupelny, technická místnost, terasa, šatna.</li>
      </ul>`,
  },
  {
    id: 'stodola',
    title: 'Stodola a kůlna',
    content: `<ul>
        <li><strong>Budova stodoly</strong> s plochou 52,40 m² projde rekonstrukcí na zimní-letní zahradu.</li>
        <li><strong>Kůlna</strong> s plochou 44,00 m² bude přestavěna na garáž a v patře vznikne pánský salonek.</li>
      </ul>`,
  },
  {
    id: 'lokalita-detail',
    title: 'Lokalita',
    content: `<p>Mnichovice, obec situovaná východně od Prahy. Tato lokalita je známá svou
      krásnou přírodou a klidným prostředím, což z ní činí atraktivní místo pro bydlení i rekreaci.</p>
      <p>V blízkosti se nachází sjezdovka <strong>Šibeniční vrch</strong> — lyžování na sjezdovce o délce cca 250 m,
      večerní lyžování, umělé zasněžování a pravidelná úprava.</p>
      <p>Větší obchodní dům <strong>Westfield Chodov</strong> se nachází pouze 15 minut jízdy autem.</p>`,
  },
];

// Gateway cards — odkazy na hlavní INVBUILD web
const gatewayCards = [
  {
    title: 'Naše projekty',
    blurb: 'Další developerské projekty od INVBUILD — nízkoenergetické stavby i rekonstrukce.',
    image: { src: '/img/mnichovice-08.webp', alt: 'Developerský projekt INVBUILD' },
    href: 'https://invbuild.cz/projekty',
    external: true,
  },
  {
    title: 'Reality v nabídce',
    blurb: 'Prodej i pronájem nemovitostí s profesionálním a lidským přístupem.',
    image: { src: '/img/mnichovice-15.webp', alt: 'Reality INVBUILD' },
    href: 'https://invbuild.cz/reality',
    external: true,
  },
  {
    title: 'Naše služby',
    blurb: 'Hypotéka, odhad, pojištění, právní servis, foto/video, VR prohlídky.',
    image: { src: '/img/mnichovice-04.webp', alt: 'Služby INVBUILD' },
    href: 'https://invbuild.cz',
    external: true,
  },
];

const navItems = [
  { id: 'hero',         label: 'Úvod' },
  { id: 'galerie',      label: 'Galerie' },
  { id: 'mnichovice',   label: 'O projektu' },
  { id: 'rekonstrukce', label: 'Rekonstrukce' },
  { id: 'dispozice',    label: 'Dispozice' },
  { id: 'lokalita',     label: 'Lokalita' },
  { id: 'invbuild',     label: 'INVBUILD' },
  { id: 'kontakt',      label: 'Kontakt' },
];
---

<Layout
  title="Rodinný dům Mnichovice — 5+1 · 159 m² · INVBUILD"
  description="Kompletní rekonstrukce rodinného domu v Mnichovicích, 15 minut od Prahy. 5+1, 159 m² užitné plochy, pozemek 480 m². Cena 31 900 000 Kč. Prodává INVBUILD."
>
  <Header />
  <SectionNav items={navItems} />

  <Hero
    title="Rodinný dům Mnichovice"
    location="Mnichovice · Praha-východ"
    stats={stats}
    images={heroImages}
  />

  <!-- 01 — GALERIE -->
  <Section
    id="galerie"
    variant="dark"
    num="01"
    eyebrow="Galerie projektu"
    title="Podívejte se dovnitř."
    intro="Šestnáct vizualizací — exteriér, interiér i detail. Plánujeme každý pokoj, každý průhled, každé světlo."
  >
    <Gallery images={galleryImages} />
  </Section>

  <!-- 02 — O PROJEKTU -->
  <Section id="mnichovice" variant="bone">
    <StorySplit
      num="02"
      eyebrow="O projektu"
      title="Mnichovice"
      caption="Vizualizace 12 — Jídelna"
      image={{ src: '/img/mnichovice-12.webp', alt: 'Jídelna v rodinném domě Mnichovice' }}
    >
      <p>
        Přinášíme kompletní rekonstrukci rodinného domu se zahradou v obci
        <strong>Mnichovice</strong>, situované východně od Prahy — patnáct minut
        od Westfield Chodov.
      </p>
      <p>
        Projekt je zasazený do venkovského stylu s moderními prvky architektury.
        Nabídne novým majitelům letní i zimní zahradu, celé volné patro
        nad garáží a hlavně dostatek soukromí.
      </p>
      <p class="split__cta-wrap">
        <a href="#galerie" class="btn btn--ink">Prohlédnout galerii</a>
      </p>
    </StorySplit>
  </Section>

  <!-- 03 — REKONSTRUKCE -->
  <Section id="rekonstrukce" variant="dark">
    <StorySplit
      variant="dark"
      reverse
      num="03"
      eyebrow="Stavba"
      title="Rekonstrukce"
      caption="Vizualizace 09 — Ložnice"
      image={{ src: '/img/mnichovice-09.webp', alt: 'Moderní interiér ložnice' }}
    >
      <p>
        Prodejní cena platí po dokončení rekonstrukce, která <strong>začala
        8. ledna 2024</strong>. Dokončení se předpokládá <strong>koncem
        roku 2024 / začátkem 2025</strong>.
      </p>
      <p>
        Nové dispoziční řešení bude <strong>5+1</strong> včetně technické místnosti,
        vstupní haly, šatny a terasy. Užitná plocha domu bez pozemku bude
        činit <strong>159 m²</strong>.
      </p>
      <p>
        V rámci celkové rekonstrukce vznikne zastřešená garáž s pokojem pro hosty
        v horním patře, přístavba jídelny s výhledem na zahradu a <strong>letní /
        zimní zahrada (kuchyň)</strong> nezávislá na počasí.
      </p>
      <p class="split__cta-wrap">
        <a href="#kontakt" class="btn btn--accent">Domluvit prohlídku</a>
      </p>
    </StorySplit>
  </Section>

  <!-- 04 — DISPOZICE -->
  <Section id="dispozice">
    <StorySplit
      num="04"
      eyebrow="Dispozice"
      title="Pět plus jedna."
      caption="Vizualizace 02 — Pohled na dům"
      image={{ src: '/img/mnichovice-02.webp', alt: 'Pohled na dům s prosklenou fasádou a zahradou' }}
    >
      <p>
        Rodinný dům nabídne dispozici <strong>5+1, případně 6+1</strong>,
        se zvýšeným důrazem na moderní prvky a luxusní vybavení. Respektuje
        venkovský styl a klade velký důraz na spojení s přírodou — prosklené
        prvky a přímé vstupy z obývacího pokoje, kuchyně a jídelny vedou
        do zahrady.
      </p>
      <p>
        Součástí potenciálu nemovitosti je velká garáž s horním patrem
        a letní / zimní zahrada.
      </p>
      <p class="split__cta-wrap">
        <a href="/dokumenty/pudorys-mnichovice.pdf" target="_blank" rel="noopener" class="btn btn--ink">
          Stáhnout PDF půdorys
        </a>
      </p>
    </StorySplit>
  </Section>

  <!-- 05 — LOKALITA -->
  <Section
    id="lokalita"
    variant="dark"
    num="05"
    eyebrow="Mapa a detail"
    title="Seznámení s budovou"
    intro="Detail místností po podlažích, technické vybavení a co je v dosahu pěti minut."
    width="wide"
  >
    <Lokalita
      address="Mnichovice, okres Praha-východ"
      coordinates="49.9300,14.7011"
      groups={locGroups}
    />
  </Section>

  <!-- 06 — INVBUILD GATEWAY -->
  <Section
    id="invbuild"
    variant="bone"
    num="06"
    eyebrow="Pokračujte"
    title="Více od INVBUILD"
    intro="Další projekty, nemovitosti v nabídce a kompletní servis na hlavním webu."
    align="center"
  >
    <Services items={gatewayCards} />
  </Section>

  <!-- 07 — KONTAKT -->
  <Section
    id="kontakt"
    num="07"
    eyebrow="Kontakt"
    title="Zajímá Vás více?"
    align="center"
  >
    <Kontakt />
  </Section>

  <Footer />
  <Reveal />
</Layout>

<style is:global>
  /* Wrapper for inline CTAs inside StorySplit body */
  .split__body .split__cta-wrap {
    margin-top: 1.5rem;
  }
</style>
