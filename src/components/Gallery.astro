---
// Gallery — velký obrázek + thumbnail strip + šipky (jak v původním Wixu)
export interface Props {
  images: { src: string; alt: string }[];
}
const { images } = Astro.props;
---

<div class="gallery" data-gallery>
  <div class="gallery__stage">
    {images.map((img, i) => (
      <figure class="gallery__main" data-active={i === 0 ? 'true' : 'false'} data-idx={i}>
        <img src={img.src} alt={img.alt} loading={i === 0 ? 'eager' : 'lazy'} />
      </figure>
    ))}

    <button class="gallery__arrow gallery__arrow--prev" aria-label="Předchozí" data-gal-prev>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="gallery__arrow gallery__arrow--next" aria-label="Další" data-gal-next>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="gallery__thumbs" role="list">
    {images.map((img, i) => (
      <button class="gallery__thumb"
              data-active={i === 0 ? 'true' : 'false'}
              data-go={i}
              aria-label={`Zobrazit foto ${i + 1}`}
              role="listitem">
        <img src={img.src} alt="" loading="lazy" />
      </button>
    ))}
  </div>
</div>

<style>
  .gallery { display: grid; gap: 1rem; }

  .gallery__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--ink-soft);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .gallery__main {
    position: absolute; inset: 0;
    opacity: 0;
    transition: opacity 350ms var(--ease-out);
  }
  .gallery__main[data-active='true'] { opacity: 1; }
  .gallery__main img { width: 100%; height: 100%; object-fit: cover; }

  .gallery__arrow {
    position: absolute;
    top: 50%; transform: translateY(-50%);
    width: 48px; height: 48px;
    border-radius: 50%;
    background: rgba(10,10,10,0.55);
    color: var(--paper);
    display: grid; place-items: center;
    z-index: 2;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .gallery__arrow:hover { background: rgba(10,10,10,0.85); }
  .gallery__arrow--prev { left: 0.75rem; }
  .gallery__arrow--next { right: 0.75rem; }

  .gallery__thumbs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
  }
  .gallery__thumb {
    flex: 0 0 clamp(110px, 14vw, 160px);
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-md);
    overflow: hidden;
    scroll-snap-align: start;
    border: 2px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
    opacity: 0.7;
  }
  .gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .gallery__thumb[data-active='true'] {
    border-color: var(--accent);
    opacity: 1;
  }
  .gallery__thumb:hover { opacity: 1; transform: translateY(-2px); }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  if (gallery) {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery__main'));
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.gallery__thumb'));
    let idx = 0;

    function go(next: number) {
      slides[idx].dataset.active = 'false';
      thumbs[idx].dataset.active = 'false';
      idx = (next + slides.length) % slides.length;
      slides[idx].dataset.active = 'true';
      thumbs[idx].dataset.active = 'true';
      thumbs[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
    }
    gallery.querySelector('[data-gal-prev]')?.addEventListener('click', () => go(idx - 1));
    gallery.querySelector('[data-gal-next]')?.addEventListener('click', () => go(idx + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.go))));

    // keyboard
    gallery.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft')  go(idx - 1);
      if (e.key === 'ArrowRight') go(idx + 1);
    });
  }
</script>
