---
// Hero — full-bleed photo carousel + title + stats overlay
// CTA "Chci poptat" je v Headeru (sticky), tady NEděláme druhé tlačítko.
export interface Props {
  title: string;
  stats: { label: string; value: string }[];
  images: { src: string; alt: string }[];
}
const { title, stats, images } = Astro.props;
---

<section id="hero" class="hero" aria-label={`Hero: ${title}`}>
  <div class="hero__carousel" data-hero-carousel>
    {images.map((img, i) => (
      <div class="hero__slide" data-active={i === 0 ? 'true' : 'false'}>
        <img src={img.src} alt={img.alt}
             loading={i === 0 ? 'eager' : 'lazy'}
             fetchpriority={i === 0 ? 'high' : 'auto'} />
      </div>
    ))}
    <div class="hero__overlay"></div>

    {images.length > 1 && (
      <>
        <button class="hero__arrow hero__arrow--prev" aria-label="Předchozí foto" data-hero-prev>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="hero__arrow hero__arrow--next" aria-label="Další foto" data-hero-next>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </>
    )}
  </div>

  <div class="hero__content container">
    <h1 class="hero__title">{title}</h1>

    <div class="hero__stats" role="list">
      {stats.map((s) => (
        <div class="hero__stat" role="listitem">
          <div class="hero__stat-label">{s.label}</div>
          <div class="hero__stat-value">{s.value}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    color: var(--paper);
    overflow: hidden;
    background: var(--ink);
  }
  .hero__carousel {
    position: absolute; inset: 0;
    z-index: 0;
  }
  .hero__slide {
    position: absolute; inset: 0;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }
  .hero__slide[data-active='true'] { opacity: 1; }
  .hero__slide img { width: 100%; height: 100%; object-fit: cover; }

  .hero__overlay {
    position: absolute; inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg,
        rgba(10,10,10,0.10) 0%,
        rgba(10,10,10,0) 30%,
        rgba(10,10,10,0.55) 70%,
        rgba(10,10,10,0.95) 100%);
  }

  .hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px; height: 52px;
    border-radius: 50%;
    background: rgba(10,10,10,0.45);
    color: var(--paper);
    border: 1px solid rgba(255,255,255,0.15);
    display: grid; place-items: center;
    z-index: 3;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .hero__arrow:hover { background: rgba(10,10,10,0.7); }
  .hero__arrow--prev { left: clamp(0.75rem, 2vw, 1.5rem); }
  .hero__arrow--next { right: clamp(0.75rem, 2vw, 1.5rem); }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    padding-top: 5rem;
  }
  .hero__title {
    max-width: 22ch;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    text-shadow: 0 2px 30px rgba(0,0,0,0.45);
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
    padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
    border-top: 1px solid rgba(255,255,255,0.28);
  }
  .hero__stat-label {
    font-size: var(--fs-sm);
    color: rgba(255,255,255,0.75);
    margin-bottom: 0.4rem;
  }
  .hero__stat-value {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }
</style>

<script>
  // Hero carousel — auto-advance + manual nav
  const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.hero__slide'));
    let idx = 0;
    let timer: number | undefined;

    function show(next: number) {
      slides[idx].dataset.active = 'false';
      idx = (next + slides.length) % slides.length;
      slides[idx].dataset.active = 'true';
    }
    function start() {
      timer = window.setInterval(() => show(idx + 1), 6500);
    }
    function reset() {
      if (timer) clearInterval(timer);
      start();
    }
    document.querySelector('[data-hero-prev]')?.addEventListener('click', () => { show(idx - 1); reset(); });
    document.querySelector('[data-hero-next]')?.addEventListener('click', () => { show(idx + 1); reset(); });

    // Pause when tab hidden
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { if (timer) clearInterval(timer); }
      else { start(); }
    });

    if (slides.length > 1) start();
  }
</script>
