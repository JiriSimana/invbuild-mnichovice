---
// Hero — full-bleed photo carousel, oversized serif title, editorial stats grid
export interface Props {
  title: string;
  location?: string;          // small caption above title (e.g. "Mnichovice · Praha-východ")
  stats: { label: string; value: string }[];
  images: { src: string; alt: string }[];
}
const { title, location, stats, images } = Astro.props;
---

<section id="hero" class="hero" aria-label={`Hero: ${title}`}>
  <div class="hero__carousel" data-hero-carousel>
    {images.map((img, i) => (
      <div class="hero__slide" data-active={i === 0 ? 'true' : 'false'}>
        <img src={img.src} alt={img.alt}
             loading={i === 0 ? 'eager' : 'lazy'}
             fetchpriority={i === 0 ? 'high' : 'auto'} />
      </div>
    ))}
    <div class="hero__overlay"></div>

    {images.length > 1 && (
      <>
        <button class="hero__arrow hero__arrow--prev" aria-label="Předchozí foto" data-hero-prev>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="hero__arrow hero__arrow--next" aria-label="Další foto" data-hero-next>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </>
    )}

    <!-- slide counter, bottom right of media -->
    {images.length > 1 && (
      <div class="hero__counter">
        <span data-hero-current>01</span>
        <span class="hero__counter-sep">/</span>
        <span>{String(images.length).padStart(2, '0')}</span>
      </div>
    )}
  </div>

  <div class="hero__content container container--wide">
    <div class="hero__intro">
      {location && <span class="eyebrow"><span class="eyebrow__num">01</span><span>{location}</span></span>}
      <h1 class="hero__title">{title}</h1>
    </div>

    <div class="hero__stats" role="list">
      {stats.map((s) => (
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-label">{s.label}</span>
          <span class="hero__stat-value lining">{s.value}</span>
        </div>
      ))}
    </div>
  </div>

  <a href="#galerie" class="hero__scroll" aria-label="Scrollovat dolů">
    <span>Scroll</span>
    <svg width="12" height="20" viewBox="0 0 12 20" fill="none" aria-hidden="true">
      <path d="M6 1V19M6 19L1 14M6 19L11 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--paper);
    overflow: hidden;
    background: var(--ink);
    isolation: isolate;
  }
  .hero__carousel {
    position: absolute; inset: 0; z-index: 0;
  }
  .hero__slide {
    position: absolute; inset: 0;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }
  .hero__slide[data-active='true'] { opacity: 1; }
  .hero__slide img {
    width: 100%; height: 100%; object-fit: cover;
    transform: scale(1.02);
    transition: transform 12s linear;
  }
  .hero__slide[data-active='true'] img { transform: scale(1.08); }

  .hero__overlay {
    position: absolute; inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg,
        rgba(20,17,12,0.10) 0%,
        rgba(20,17,12,0) 30%,
        rgba(20,17,12,0.55) 70%,
        rgba(20,17,12,0.95) 100%);
  }

  /* arrows */
  .hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px; height: 56px;
    border-radius: 50%;
    background: rgba(20,17,12,0.35);
    color: var(--paper);
    border: 1px solid rgba(255,255,255,0.18);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: grid; place-items: center;
    z-index: 3;
    transition: background var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }
  .hero__arrow:hover {
    background: rgba(20,17,12,0.55);
    border-color: rgba(255,255,255,0.35);
  }
  .hero__arrow--prev { left: clamp(1rem, 2.5vw, 2rem); }
  .hero__arrow--next { right: clamp(1rem, 2.5vw, 2rem); }

  /* slide counter */
  .hero__counter {
    position: absolute;
    bottom: clamp(1rem, 2.5vw, 2rem);
    right: clamp(1rem, 2.5vw, 2rem);
    z-index: 3;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    color: rgba(255,255,255,0.85);
    display: flex; gap: 0.4rem;
    background: rgba(20,17,12,0.4);
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .hero__counter-sep { opacity: 0.5; }

  /* content */
  .hero__content {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(3rem, 6vw, 5rem);
    padding-top: 5rem;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: flex-end;
  }
  @media (max-width: 860px) {
    .hero__content { grid-template-columns: 1fr; }
  }

  .hero__intro .eyebrow {
    color: rgba(255,255,255,0.8);
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }
  .hero__intro .eyebrow__num { color: var(--accent); }

  .hero__title {
    font-size: var(--fs-mega);
    line-height: 0.95;
    letter-spacing: var(--tracking-tightest);
    font-weight: 300;
    text-wrap: balance;
    max-width: 14ch;
    text-shadow: 0 2px 40px rgba(0,0,0,0.35);
    font-variation-settings: 'opsz' 144, 'SOFT' 20;
  }

  /* stats */
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
    padding-top: clamp(1.5rem, 2.5vw, 2rem);
    border-top: 1px solid rgba(255,255,255,0.22);
    align-self: end;
  }
  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .hero__stat-label {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-extra);
    color: rgba(255,255,255,0.65);
  }
  .hero__stat-value {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 400;
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    font-variation-settings: 'opsz' 60, 'SOFT' 50;
  }

  /* scroll indicator */
  .hero__scroll {
    position: absolute;
    left: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 2rem);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: rgba(255,255,255,0.7);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .hero__scroll:hover { color: var(--paper); }
  .hero__scroll svg {
    animation: scrollHint 2.5s var(--ease-in-out) infinite;
  }
  @keyframes scrollHint {
    0%, 100% { transform: translateY(0); opacity: 0.7; }
    50%      { transform: translateY(4px); opacity: 1; }
  }
  @media (max-width: 600px) { .hero__scroll { display: none; } }
</style>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.hero__slide'));
    const counter = document.querySelector<HTMLElement>('[data-hero-current]');
    let idx = 0;
    let timer: number | undefined;

    function show(next: number) {
      slides[idx].dataset.active = 'false';
      idx = (next + slides.length) % slides.length;
      slides[idx].dataset.active = 'true';
      if (counter) counter.textContent = String(idx + 1).padStart(2, '0');
    }
    function start() { timer = window.setInterval(() => show(idx + 1), 7000); }
    function reset()  { if (timer) clearInterval(timer); start(); }

    document.querySelector('[data-hero-prev]')?.addEventListener('click', () => { show(idx - 1); reset(); });
    document.querySelector('[data-hero-next]')?.addEventListener('click', () => { show(idx + 1); reset(); });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { if (timer) clearInterval(timer); }
      else { start(); }
    });

    if (slides.length > 1) start();
  }
</script>
