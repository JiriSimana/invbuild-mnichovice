---
// SectionNav — sticky pravý scrollspy s vždy viditelnými labely.
// Klikatelné. IntersectionObserver pro aktivní stav. Auto-flip barev nad tmavými sekcemi.
export interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<nav class="snav" aria-label="Navigace po sekcích" data-section-nav>
  <ul role="list">
    {items.map((it, i) => (
      <li>
        <a href={`#${it.id}`} data-snav-link={it.id} aria-label={`${String(i + 1).padStart(2, '0')} — ${it.label}`}>
          <span class="snav__label">{it.label}</span>
          <span class="snav__num lining">{String(i + 1).padStart(2, '0')}</span>
          <span class="snav__dot" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .snav {
    position: fixed;
    right: clamp(0.75rem, 1.5vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--z-sticky);
    pointer-events: none;
  }
  .snav ul {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    pointer-events: auto;
  }

  /* Hairline left of stack, optional */
  .snav::before {
    content: '';
    position: absolute;
    left: -8px;
    top: 8px; bottom: 8px;
    width: 1px;
    background: var(--line);
    opacity: 0.35;
  }

  .snav a {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0;
    color: var(--ink);
    opacity: 0.55;
    transition: opacity var(--dur-fast) var(--ease-out),
                gap var(--dur-base) var(--ease-out);
  }
  .snav a:hover { opacity: 1; }
  .snav a[data-active='true'] { opacity: 1; gap: 0.9rem; }

  .snav__label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: inherit;
    white-space: nowrap;
    text-align: right;
  }
  .snav__num {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-wide);
    color: var(--muted);
    text-align: right;
    min-width: 1.6em;
  }
  .snav__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    transition: width var(--dur-base) var(--ease-out),
                background var(--dur-fast) var(--ease-out),
                box-shadow var(--dur-fast) var(--ease-out);
  }

  /* Active state */
  .snav a[data-active='true'] .snav__dot {
    background: var(--accent);
    width: 22px;
    border-radius: 3px;
    box-shadow: 0 0 0 4px rgba(217, 152, 33, 0.15);
  }
  .snav a[data-active='true'] .snav__num { color: var(--accent); }

  /* ON LIGHT — default colors fine */

  /* ON DARK — explicit overrides for visibility */
  .snav[data-on-dark='true'] a {
    color: rgba(255, 255, 255, 0.92);
    opacity: 0.7;
  }
  .snav[data-on-dark='true'] a:hover,
  .snav[data-on-dark='true'] a[data-active='true'] {
    opacity: 1;
  }
  .snav[data-on-dark='true'] .snav__num   { color: rgba(255, 255, 255, 0.6); }
  .snav[data-on-dark='true'] .snav__label { color: rgba(255, 255, 255, 0.95); }
  .snav[data-on-dark='true']::before { background: rgba(255, 255, 255, 0.25); opacity: 0.4; }
  .snav[data-on-dark='true'] a[data-active='true'] .snav__num { color: var(--accent); }

  /* Hide on mobile/tablet — drawer covers this */
  @media (max-width: 1100px) {
    .snav { display: none; }
  }
</style>

<script>
  const nav  = document.querySelector<HTMLElement>('[data-section-nav]');
  const links = nav ? Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-snav-link]')) : [];
  const sections = links
    .map((l) => document.getElementById(l.dataset.snavLink ?? ''))
    .filter((el): el is HTMLElement => !!el);

  if (nav && links.length && sections.length) {
    let activeId = '';
    const setActive = (id: string) => {
      if (id === activeId) return;
      activeId = id;
      links.forEach((l) => {
        l.dataset.active = l.dataset.snavLink === id ? 'true' : 'false';
      });
    };

    // Detect whether the section at the right-middle of the viewport is dark
    const updateContrast = () => {
      const cx = window.innerWidth - 80;
      const cy = window.innerHeight / 2;
      const el = document.elementFromPoint(cx, cy);
      if (!el) return;
      const onDarkSection = el.closest('.section--dark');
      const onHero = el.closest('#hero');
      nav.dataset.onDark = (onDarkSection || onHero) ? 'true' : 'false';
    };

    // IntersectionObserver — pick section with biggest visible area
    const io = new IntersectionObserver(
      () => {
        let bestId = activeId;
        let bestRatio = 0;
        for (const s of sections) {
          const r = s.getBoundingClientRect();
          const vis = Math.max(0, Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0));
          const ratio = vis / window.innerHeight;
          if (ratio > bestRatio) { bestRatio = ratio; bestId = s.id; }
        }
        if (bestId) setActive(bestId);
        updateContrast();
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    sections.forEach((s) => io.observe(s));

    // Update contrast on scroll (rAF-throttled)
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { updateContrast(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });

    setActive(sections[0].id);
    updateContrast();
  }
</script>
