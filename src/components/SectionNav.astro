---
// SectionNav — sticky pravý scrollspy v glass-blur pillu.
// Vlastní tmavé pozadí → vždy čitelné nad jakoukoliv sekcí (žádné auto-detection).
export interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<nav class="snav" aria-label="Navigace po sekcích" data-section-nav>
  <ul role="list">
    {items.map((it, i) => (
      <li>
        <a href={`#${it.id}`} data-snav-link={it.id} aria-label={`${String(i + 1).padStart(2, '0')} — ${it.label}`}>
          <span class="snav__label">{it.label}</span>
          <span class="snav__num lining">{String(i + 1).padStart(2, '0')}</span>
          <span class="snav__dot" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* Glass-blur pill — vlastní tmavé pozadí pro konzistentní čitelnost */
  .snav {
    position: fixed;
    right: clamp(0.75rem, 1.5vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--z-sticky);

    background: rgba(20, 17, 12, 0.62);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 0.85rem 1.05rem 0.85rem 0.95rem;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.22);
  }
  .snav ul {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Items */
  .snav a {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 0;
    color: rgba(255, 255, 255, 0.62);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .snav a:hover,
  .snav a[data-active='true'] {
    color: var(--paper);
  }

  /* Label — vždy viditelný */
  .snav__label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: inherit;
    white-space: nowrap;
    text-align: right;
  }

  /* Number — drobné v monospace */
  .snav__num {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-wide);
    color: rgba(255, 255, 255, 0.45);
    text-align: right;
    min-width: 1.6em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .snav a[data-active='true'] .snav__num { color: var(--accent); }

  /* Dot — aktivní = žlutý protáhlý */
  .snav__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    transition: width var(--dur-base) var(--ease-out),
                background var(--dur-fast) var(--ease-out),
                box-shadow var(--dur-fast) var(--ease-out);
  }
  .snav a[data-active='true'] .snav__dot {
    background: var(--accent);
    width: 22px;
    border-radius: 3px;
    box-shadow: 0 0 0 4px rgba(217, 152, 33, 0.18);
  }

  /* Hide on mobile/tablet — drawer covers this */
  @media (max-width: 1100px) {
    .snav { display: none; }
  }
</style>

<script>
  const nav  = document.querySelector<HTMLElement>('[data-section-nav]');
  const links = nav ? Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-snav-link]')) : [];
  const sections = links
    .map((l) => document.getElementById(l.dataset.snavLink ?? ''))
    .filter((el): el is HTMLElement => !!el);

  if (nav && links.length && sections.length) {
    let activeId = '';
    const setActive = (id: string) => {
      if (id === activeId) return;
      activeId = id;
      links.forEach((l) => {
        l.dataset.active = l.dataset.snavLink === id ? 'true' : 'false';
      });
    };

    const io = new IntersectionObserver(
      () => {
        let bestId = activeId;
        let bestRatio = 0;
        for (const s of sections) {
          const r = s.getBoundingClientRect();
          const vis = Math.max(0, Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0));
          const ratio = vis / window.innerHeight;
          if (ratio > bestRatio) { bestRatio = ratio; bestId = s.id; }
        }
        if (bestId) setActive(bestId);
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    sections.forEach((s) => io.observe(s));

    setActive(sections[0].id);
  }
</script>
