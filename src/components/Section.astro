---
// Generic section wrapper with editorial numbered header
export interface Props {
  id?: string;
  num?: string;          // "01", "02"...
  eyebrow?: string;
  title?: string;
  intro?: string;        // short body sentence below title
  variant?: 'default' | 'bone' | 'cream' | 'dark';
  align?: 'left' | 'center';
  tight?: boolean;       // less vertical padding
  width?: 'default' | 'wide' | 'narrow';
}
const {
  id,
  num,
  eyebrow,
  title,
  intro,
  variant = 'default',
  align = 'left',
  tight = false,
  width = 'default',
} = Astro.props;

const sectionClass = [
  'section',
  variant === 'bone'  && 'section--bone',
  variant === 'cream' && 'section--cream',
  variant === 'dark'  && 'section--dark',
  tight && 'section--tight',
].filter(Boolean).join(' ');

const containerClass = [
  'container',
  width === 'wide'   && 'container--wide',
  width === 'narrow' && 'container--narrow',
].filter(Boolean).join(' ');
---

<section id={id} class={sectionClass}>
  <div class={containerClass}>
    {(eyebrow || title || intro) && (
      <header class:list={['s-head', align === 'center' && 's-head--center']} data-reveal>
        {(num || eyebrow) && (
          <span class="eyebrow">
            {num && <span class="eyebrow__num">{num}</span>}
            {eyebrow && <span>{eyebrow}</span>}
          </span>
        )}
        {title && <h2 class="s-head__title">{title}</h2>}
        {intro && <p class="s-head__intro">{intro}</p>}
      </header>
    )}
    <slot />
  </div>
</section>

<style>
  .s-head {
    max-width: 38ch;
    margin-bottom: clamp(3rem, 6vw, 5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .s-head--center {
    margin-inline: auto;
    text-align: center;
    align-items: center;
    max-width: 56ch;
  }

  .s-head__title {
    /* slightly tighter than top-level h1 */
    margin: 0;
  }

  .s-head__intro {
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--muted);
    max-width: 48ch;
    font-weight: 300;
    letter-spacing: var(--tracking-base);
  }
  .section--dark .s-head__intro { color: rgba(255,255,255,0.7); }
</style>
