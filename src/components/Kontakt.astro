---
// Kontakt — editoriální formulář. Větší prostor, jemnější vstupy, klidnější rytmus.
export interface Props {
  phone?: string;
  altPhone?: string;
  email?: string;
  website?: string;
}
const {
  phone    = '+420 704 971 814',
  altPhone = '+420 704 971 809',
  email    = 'info@invbuild.cz',
  website  = 'www.invbuild.cz',
} = Astro.props;
---

<div class="kontakt">
  <div class="kontakt__intro" data-reveal>
    <p class="kontakt__lead">
      V rámci probíhající rekonstrukce má nový potenciální majitel možnosti
      a velkou výhodu si říct, jaké úpravy či možné změny se dají realizovat
      dle vlastních přání.
    </p>
    <p class="kontakt__alt">
      Případně nás neváhejte kontaktovat na
      <a href={`tel:${altPhone.replace(/\s/g, '')}`}>{altPhone}</a>
      nebo na
      <a href={`https://${website}`} target="_blank" rel="noopener">{website}</a>.
    </p>
  </div>

  <form class="form" id="poptavka" method="POST" action="/api/poptavka" novalidate data-reveal>
    <div class="form__field">
      <label for="name">Jméno a příjmení</label>
      <input id="name" name="name" type="text" required autocomplete="name" />
    </div>

    <div class="form__row">
      <div class="form__field">
        <label for="phone">Telefon</label>
        <input id="phone" name="phone" type="tel" required autocomplete="tel" />
      </div>
      <div class="form__field">
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </div>
    </div>

    <div class="form__field">
      <label for="message">Vaše zpráva</label>
      <textarea id="message" name="message" rows="4" required placeholder="Co byste rádi věděli o projektu?"></textarea>
    </div>

    <div class="form__foot">
      <label class="form__gdpr">
        <input type="checkbox" name="gdpr" required />
        <span>Souhlasím se <a href="/gdpr">zpracováním osobních údajů</a>.</span>
      </label>
      <button type="submit" class="form__submit">
        <span>Odeslat poptávku</span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </form>
</div>

<style>
  .kontakt {
    max-width: 780px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  .kontakt__intro { text-align: center; }
  .kontakt__lead {
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--muted);
    max-width: 56ch;
    margin-inline: auto;
    font-weight: 300;
  }
  .kontakt__alt {
    margin-top: 1.25rem;
    font-size: var(--fs-sm);
    color: var(--muted-soft);
  }
  .kontakt__alt a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent);
  }

  .form { display: flex; flex-direction: column; gap: 1.75rem; }
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  @media (max-width: 560px) { .form__row { grid-template-columns: 1fr; } }

  .form__field { display: flex; flex-direction: column; gap: 0.4rem; }
  .form__field label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-extra);
    color: var(--muted);
    font-weight: 500;
  }
  .form__field input,
  .form__field textarea {
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 0.7rem 0;
    font-size: var(--fs-base);
    color: inherit;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .form__field input:focus,
  .form__field textarea:focus {
    outline: none;
    border-bottom-color: var(--ink);
  }
  .form__field textarea { resize: vertical; min-height: 96px; }

  .form__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    padding-top: 0.5rem;
    flex-wrap: wrap;
  }
  .form__gdpr {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-size: var(--fs-xs);
    color: var(--muted);
    max-width: 38ch;
    line-height: 1.4;
  }
  .form__gdpr a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent);
  }

  .form__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.75rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: background var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
  }
  .form__submit:hover {
    background: var(--accent);
    color: var(--accent-ink);
    transform: translateY(-1px);
  }
  .form__submit svg {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .form__submit:hover svg { transform: translate(2px, -2px); }
</style>
