---
// Lokalita — mapa + refinovaný accordion. NE plně žluté panely — místo toho cream pozadí
// se žlutým markerem + serif nadpis. Editoriálnější, klidnější.
export interface Props {
  coordinates?: string;
  address?: string;
  groups: { id: string; title: string; content: string }[];
}
const {
  coordinates = '49.9300,14.7011',
  address = 'Mnichovice, okres Praha-východ',
  groups,
} = Astro.props;

const [lat, lng] = coordinates.split(',');
const gmapsSrc = `https://www.google.com/maps?q=${lat},${lng}&hl=cs&z=12&output=embed`;
---

<div class="lokalita">
  <div class="lokalita__map" data-reveal>
    <iframe
      src={gmapsSrc}
      title={`Mapa: ${address}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>

  <div class="lokalita__panels" data-reveal>
    {groups.map((g, i) => (
      <details class="acc" name="lokalita-acc" open={i === 0}>
        <summary class="acc__head">
          <span class="acc__num lining">{String(i + 1).padStart(2, '0')}</span>
          <span class="acc__title">{g.title}</span>
          <span class="acc__icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </summary>
        <div class="acc__body" set:html={g.content}></div>
      </details>
    ))}
  </div>
</div>

<style>
  .lokalita {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: stretch;
  }
  @media (max-width: 1000px) {
    .lokalita { grid-template-columns: 1fr; }
  }

  /* map */
  .lokalita__map {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--ink-soft);
    min-height: 480px;
    position: sticky;
    top: clamp(4rem, 8vh, 7rem);
    align-self: start;
  }
  @media (max-width: 1000px) {
    .lokalita__map { aspect-ratio: 16 / 10; min-height: 320px; position: static; }
  }
  .lokalita__map iframe { width: 100%; height: 100%; border: 0; filter: grayscale(0.4) contrast(1.02); }

  /* panels — minimal editorial accordion */
  .lokalita__panels {
    display: flex;
    flex-direction: column;
  }

  .acc {
    border-top: 1px solid rgba(255,255,255,0.12);
    transition: background var(--dur-base) var(--ease-out);
  }
  .acc:last-of-type { border-bottom: 1px solid rgba(255,255,255,0.12); }
  .acc[open] { background: rgba(255,255,255,0.03); }

  .acc__head {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 0.25rem 1.5rem 0.25rem;
    user-select: none;
    transition: padding var(--dur-base) var(--ease-out);
  }
  .acc[open] .acc__head { padding-bottom: 0.5rem; }
  .acc__head::-webkit-details-marker { display: none; }
  .acc__head::marker { display: none; content: ''; }

  .acc__num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--accent);
    opacity: 0.85;
  }
  .acc__title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    font-weight: 400;
    letter-spacing: var(--tracking-tight);
    color: var(--paper);
    font-variation-settings: 'opsz' 60, 'SOFT' 50;
  }
  .acc__icon {
    color: rgba(255,255,255,0.5);
    transition: transform var(--dur-base) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }
  .acc[open] .acc__icon {
    transform: rotate(180deg);
    color: var(--accent);
  }
  .acc:hover .acc__icon { color: var(--accent); }

  .acc__body {
    padding: 0 0.25rem 1.75rem;
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: rgba(255,255,255,0.78);
    max-width: 56ch;
  }
  .acc__body :global(p) + :global(p) { margin-top: 0.6rem; }
  .acc__body :global(p) { margin-bottom: 0.85rem; }
  .acc__body :global(ul) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .acc__body :global(li) {
    position: relative;
    padding-left: 1.1rem;
  }
  .acc__body :global(li)::before {
    content: '';
    position: absolute;
    left: 0; top: 0.7em;
    width: 6px; height: 1px;
    background: var(--accent);
  }
  .acc__body :global(strong) {
    color: var(--paper);
    font-weight: 500;
  }

  /* light variant — for non-dark sections */
  :global(.section:not(.section--dark)) .acc {
    border-top-color: var(--line);
  }
  :global(.section:not(.section--dark)) .acc:last-of-type {
    border-bottom-color: var(--line);
  }
  :global(.section:not(.section--dark)) .acc[open] {
    background: rgba(20,17,12,0.02);
  }
  :global(.section:not(.section--dark)) .acc__title { color: var(--ink); }
  :global(.section:not(.section--dark)) .acc__body { color: var(--muted); }
  :global(.section:not(.section--dark)) .acc__body :global(strong) { color: var(--ink); }
  :global(.section:not(.section--dark)) .acc__icon { color: var(--muted-soft); }
</style>
