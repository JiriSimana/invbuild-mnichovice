---
// Lokalita — mapa vlevo + žluté accordion panely vpravo s detaily o budově/místnostech.
// Native <details> + <summary> = accessible, žádný JS.
export interface Props {
  /** GPS souřadnice ve formátu "lat,lng" */
  coordinates?: string;
  address?: string;
  groups: {
    id: string;
    title: string;
    /** HTML/markdown content — předáváme jako string. Pro list použít HTML <ul><li>... */
    content: string;
  }[];
}
const {
  coordinates = '49.9300,14.7011',
  address = 'Mnichovice, okres Praha-východ',
  groups,
} = Astro.props;

const [lat, lng] = coordinates.split(',');
// Google Maps embed (no API key required for basic embed)
const gmapsSrc = `https://www.google.com/maps?q=${lat},${lng}&hl=cs&z=12&output=embed`;
---

<div class="lokalita">
  <div class="lokalita__map">
    <iframe
      src={gmapsSrc}
      title={`Mapa: ${address}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>

  <div class="lokalita__panels">
    {groups.map((g, i) => (
      <details class="acc" name="lokalita-acc" open={i === 0}>
        <summary class="acc__head">
          <span class="acc__icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="acc__title">{g.title}</span>
        </summary>
        <div class="acc__body" set:html={g.content}></div>
      </details>
    ))}
  </div>
</div>

<style>
  .lokalita {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }
  @media (max-width: 960px) {
    .lokalita { grid-template-columns: 1fr; }
  }

  .lokalita__map {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--ink-soft);
    min-height: 480px;
  }
  @media (max-width: 960px) {
    .lokalita__map { aspect-ratio: 16 / 10; min-height: 320px; }
  }
  .lokalita__map iframe { width: 100%; height: 100%; border: 0; filter: grayscale(0.2); }

  /* ---- accordion ---- */
  .lokalita__panels {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .acc {
    background: var(--accent);
    border-radius: var(--radius-md);
    overflow: hidden;
    color: var(--accent-ink);
    border: 0;
  }
  .acc[open] { background: var(--accent-panel); }

  .acc__head {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.05rem 1.25rem;
    font-weight: 600;
    font-size: var(--fs-base);
    user-select: none;
  }
  .acc__head::-webkit-details-marker { display: none; }
  .acc__icon {
    display: grid; place-items: center;
    width: 24px; height: 24px;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .acc[open] .acc__icon { transform: rotate(45deg); }
  .acc__title { letter-spacing: 0.02em; text-transform: uppercase; }

  .acc__body {
    padding: 0 1.25rem 1.25rem 1.25rem;
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .acc__body :global(p) + :global(p) { margin-top: 0.6rem; }
  .acc__body :global(ul) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .acc__body :global(li) {
    position: relative;
    padding-left: 1rem;
  }
  .acc__body :global(li)::before {
    content: '';
    position: absolute;
    left: 0; top: 0.55em;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--accent-ink);
  }
  .acc__body :global(strong) { font-weight: 600; }
</style>
